# KAIROS Copilot Server-Side AI Provider Configuration (Optional)
# Copy this file to .env.local to enable cloud LLM generation.
# Credentials are read strictly on the server inside app/api/assistant/route.js
# and are never exposed to the browser.
# When no key is configured, KAIROS Copilot operates using the built-in
# KAIROS Grounded Intelligence Engine over verified repository records.

# Option 1: Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option 2: OpenAI Compatible API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option 3: Groq API
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
